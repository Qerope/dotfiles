[user]
	name = Qerope
	email = preloopadm@gmail.com
[core]
	editor = vim
[pull]
	rebase = true
[alias]
	lg = log --graph --pretty=format:'%h %s (%cr) <%an>'
	st = status -sb
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[init]
	defaultBranch = main
[gpg]
	format = ssh
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
